# Claude Lens — copy to .env and fill in values
# Get a Groq key: https://console.groq.com/keys
# Never commit .env (real secrets)

# Required for live LLM (Phase 3+). Leave empty only if DEMO_MODE=1
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile if unset
# Fast/cheap dev: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Inject training corpus from answers.md into prompts
CLAUDE_LENS_USE_CORPUS=1

# 1 = serve phase 1 training JSON without calling Groq (no API key needed)
CLAUDE_LENS_DEMO_MODE=0

# 1 = CI/compare API output to golden fixtures
CLAUDE_LENS_EVAL_MODE=0

# Backend URL (Phase 2 frontend → Phase 3+ API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
